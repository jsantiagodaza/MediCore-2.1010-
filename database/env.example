# Copia este archivo a .env y completa los valores. NO subas .env a Git.
# Instancia remota: la mayoría de proveedores exigen SSL.
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST_REMOTO:5432/medicore?sslmode=require
# Base de prueba para verificar restauraciones:
TARGET_DATABASE_URL=postgresql://USUARIO:CLAVE@HOST_REMOTO:5432/medicore_restore_test?sslmode=require
BACKUP_DIR=./backups
